{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/app",
      "destination": "/app.html"
    },
    {
      "source": "/try-contrib",
      "destination": "/try-contrib.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
