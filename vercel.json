{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/llms.txt",
      "destination": "/llms.txt"
    },
    {
      "source": "/app",
      "destination": "/app.html"
    },
    {
      "source": "/demo",
      "destination": "/demo.html"
    },
    {
      "source": "/building",
      "destination": "/app.html"
    },
    {
      "source": "/BuildingSection",
      "destination": "/app.html"
    },
    {
      "source": "/try-contrib",
      "destination": "/try-contrib.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
